<%#
# Show

This view is the template for the show page.
It renders the attributes of a resource,
as well as a link to its edit page.

## Local variables:

- `page`:
  An instance of [Administrate::Page::Show][1].
  Contains methods for accessing the resource to be displayed on the page,
  as well as helpers for describing how each attribute of the resource
  should be displayed.

[1]: http://www.rubydoc.info/gems/administrate/Administrate/Page/Show
%>

<% content_for(:title) { t("administrate.actions.show_resource", name: page.page_title) } %>

<div class="flex flex-col gap-6 px-8 pt-8 pb-12 min-h-full bg-slate-25">
  <header class="flex flex-wrap gap-4 justify-between items-center" role="banner">
    <h1 class="text-2xl font-bold text-slate-800">
      <%= content_for(:title) %>
    </h1>

    <div class="flex flex-wrap gap-3 items-center">
      <%= link_to(
              t("administrate.actions.edit"),
              [:edit, namespace,  page.resource.becomes(User)],
              class: "inline-flex items-center px-3.5 py-2 text-sm font-semibold text-white whitespace-nowrap rounded-lg bg-woot-500 hover:bg-woot-600",
            ) if authorized_action? page.resource, :edit %>
      <%= button_to(
              t("super_admin.users.resend_confirmation.button"),
              [:resend_confirmation, namespace, page.resource.becomes(User)],
              method: :post,
              class: "inline-flex items-center px-3.5 py-2 text-sm font-medium whitespace-nowrap rounded-lg border cursor-pointer bg-white border-slate-75 text-slate-800 hover:text-woot-600",
              form_class: "contents",
            ) unless page.resource.confirmed? %>
    </div>
  </header>

  <% page.attributes.each do |title, attributes| %>
    <section class="flex flex-col gap-4 p-6 bg-white rounded-xl border border-slate-75">
      <% if title.present? %>
        <h2 class="text-base font-semibold text-slate-800">
          <%= t "helpers.label.#{page.resource_name}.#{title}", default: title %>
        </h2>
      <% end %>

      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
        <% attributes.each do |attribute| %>
          <dt class="text-sm font-medium text-slate-600" id="<%= attribute.name %>">
          <%= t(
            "helpers.label.#{resource_name}.#{attribute.name}",
            default: page.resource.class.human_attribute_name(attribute.name),
          ) %>
          </dt>

          <dd class="text-sm break-words text-slate-800"
              ><%= render_field attribute, page: page %></dd>
        <% end %>
      </dl>
    </section>
  <% end %>

  <section class="flex flex-col gap-4 p-6 bg-white rounded-xl border border-slate-75">
    <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
      <dt class="text-sm font-medium text-slate-600" id="mfa_enabled"><%= t('super_admin.users.mfa.label') %></dt>
      <dd class="text-sm">
        <% mfa_enabled = page.resource.mfa_enabled? %>
        <span class="<%= mfa_enabled ? 'bg-green-100 text-green-700' : 'bg-slate-50 text-slate-600' %> inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium">
          <%= mfa_enabled ? t('super_admin.users.mfa.enabled') : t('super_admin.users.mfa.disabled') %>
        </span>
      </dd>
    </dl>
  </section>

  <%= render 'super_admin/shared/account_user_form', page: page, namespace: namespace, resource_type: 'user' %>

  <%= render partial: "impersonate", locals: {page: page} %>
</div>
