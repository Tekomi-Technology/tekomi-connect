<% content_for(:title) do %>
  <%= t('super_admin.app_configs.title', config: t("super_admin.features.#{@config}.name", default: @config.titleize)) %>
<% end %>

<style>
.eye-icon.eye-hide path {
  d: path('M3 3l18 18M10.5 10.677a2 2 0 002.823 2.823M7.362 7.561C5.68 8.74 4.279 10.42 3 12c1.889 2.991 5.282 6 9 6 1.55 0 3.043-.523 4.395-1.35M12 6c4.008 0 6.701 3.009 9 6a15.66 15.66 0 01-1.078 1.5');
}
</style>

<div class="flex flex-col gap-6 px-8 pt-8 pb-12 min-h-full bg-slate-25">
  <header role="banner">
    <h1 class="text-2xl font-bold text-slate-800" id="page-title">
      <%= content_for(:title) %>
    </h1>
  </header>

  <section class="p-6 bg-white rounded-xl border border-slate-75">
    <%= form_with url: super_admin_app_config_url(config: @config) , method: :post do |form| %>
      <div class="flex flex-col gap-6">
        <% @allowed_configs.each do |key| %>
          <div class="grid gap-x-6 gap-y-2 items-start pb-6 border-b sm:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] border-slate-50 last:border-0 last:pb-0">
            <%= form.label "app_config[#{key}]", t("super_admin.app_configs.fields.#{key}.title", default: @installation_configs[key]&.dig('display_title') || key), class: "pt-2 text-sm font-medium text-slate-800" %>

            <div class="flex flex-col gap-2 min-w-0">
              <% if @installation_configs[key]&.dig('type') == 'boolean' %>
                <%= form.select "app_config[#{key}]",
                  [[t('super_admin.app_configs.true'), true], [t('super_admin.app_configs.false'), false]],
                  { selected: ActiveModel::Type::Boolean.new.cast(@app_config[key]) },
                  class: "px-3 py-2 w-full text-sm rounded-lg border border-slate-75 text-slate-800 focus:border-woot-500 focus:outline-none"
                %>
              <% elsif @installation_configs[key]&.dig('type') == 'code' %>
                <%= form.text_area "app_config[#{key}]",
                    value: @app_config[key],
                    rows: 12,
                    wrap: 'off',
                    class: "overflow-auto px-3 py-2 w-full font-mono text-xs rounded-lg border border-slate-75 text-slate-800 focus:border-woot-500 focus:outline-none"
                %>
              <% elsif @installation_configs[key]&.dig('type') == 'secret' %>
                <div class="relative">
                  <%= form.password_field "app_config[#{key}]",
                      id: "app_config_#{key}",
                      value: @app_config[key],
                      class: "px-3 py-2 pr-10 w-full text-sm rounded-lg border border-slate-75 text-slate-800 focus:border-woot-500 focus:outline-none"
                  %>
                  <button
                    type="button"
                    class="flex absolute right-2 top-1/2 justify-center items-center p-1 rounded -translate-y-1/2 toggle-password text-slate-600 hover:text-woot-600"
                    data-target="app_config_<%= key %>"
                  >
                    <svg class="eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 5C5.63636 5 2 12 2 12C2 12 5.63636 19 12 19C18.3636 19 22 12 22 12C22 12 18.3636 5 12 5Z"/>
                      <path d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"/>
                    </svg>
                  </button>
                </div>
              <% elsif @installation_configs[key]&.dig('type') == 'select' && @installation_configs[key]&.dig('options').present? %>
                <%= form.select "app_config[#{key}]",
                  @installation_configs[key]['options'].map { |val, label| [label, val] },
                  { selected: @app_config[key] },
                  class: "px-3 py-2 w-full text-sm rounded-lg border border-slate-75 text-slate-800 focus:border-woot-500 focus:outline-none"
                %>
              <% else %>
                <%= form.text_field "app_config[#{key}]", value: @app_config[key], class: "px-3 py-2 w-full text-sm rounded-lg border border-slate-75 text-slate-800 focus:border-woot-500 focus:outline-none" %>
              <% end %>

              <%if @installation_configs[key]&.dig('description').present? %>
                <p class="text-xs text-slate-600">
                  <%= t("super_admin.app_configs.fields.#{key}.description", default: @installation_configs[key]['description']) %>
                </p>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="flex items-start">
          <%= form.submit t('super_admin.app_configs.submit'), class: "px-3.5 py-2 text-sm font-semibold text-white rounded-lg cursor-pointer bg-woot-500 hover:bg-woot-600" %>
        </div>
      </div>
    <% end %>
  </section>
</div>

<% content_for :javascript do %>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target;
        const input = document.getElementById(targetId);
        const type = input.type === 'password' ? 'text' : 'password';
        input.type = type;

        // Toggle icon
        const svg = button.querySelector('.eye-icon');
        if (type === 'password') {
          svg.classList.remove('eye-hide')
        } else {
          svg.classList.add('eye-hide')
        }
      });
    });
  });
  </script>
<% end %>
