<% content_for(:title) { t('administrate.actions.show_resource', name: page.page_title) } %>

<div class="flex flex-col gap-6 px-8 pt-8 pb-12 min-h-full bg-slate-25">
  <header class="flex flex-wrap gap-4 justify-between items-center">
    <h1 class="text-2xl font-bold text-slate-800"><%= content_for(:title) %></h1>
    <div class="flex flex-wrap gap-3 items-center">
      <%= button_to t('super_admin.tenant_branding_profiles.provision_now'),
                    provision_super_admin_tenant_branding_profile_path(page.resource),
                    method: :post,
                    class: 'inline-flex items-center px-3.5 py-2 text-sm font-semibold text-white rounded-lg bg-woot-500 hover:bg-woot-600' %>
      <%= link_to t('administrate.actions.edit'), [:edit, namespace, page.resource],
                  class: 'inline-flex items-center px-3.5 py-2 text-sm font-semibold text-white rounded-lg bg-woot-500 hover:bg-woot-600' %>
    </div>
  </header>

  <% page.attributes.each do |title, attributes| %>
    <section class="flex flex-col gap-4 p-6 bg-white rounded-xl border border-slate-75">
      <% if title.present? %>
        <h2 class="text-base font-semibold text-slate-800"><%= title %></h2>
      <% end %>
      <dl class="grid gap-x-6 gap-y-4 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
        <% attributes.each do |attribute| %>
          <dt class="text-sm font-medium text-slate-600"><%= page.resource.class.human_attribute_name(attribute.name) %></dt>
          <dd class="text-sm break-words text-slate-800"><%= render_field attribute, page: page %></dd>
        <% end %>
      </dl>
    </section>
  <% end %>
</div>
