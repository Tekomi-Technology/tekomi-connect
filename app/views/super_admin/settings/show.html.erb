<% content_for(:title) do %>
  <%= t('super_admin.settings.title') %>
<% end %>

<div class="flex flex-col gap-6 px-8 pt-8 pb-12 min-h-full bg-slate-25">
  <header class="flex gap-4 items-center" role="banner">
    <div class="flex justify-center items-center w-11 h-11 bg-white rounded-full border shrink-0 border-slate-75 text-slate-800">
      <svg width="22" height="22"><use xlink:href="#icon-settings-2-line" /></svg>
    </div>
    <div class="flex flex-col gap-0.5 min-w-0">
      <h1 class="text-2xl font-bold text-slate-800" id="page-title">
        <%= content_for(:title) %>
      </h1>
      <p class="m-0 text-sm text-slate-600"><%= t('super_admin.settings.subtitle') %></p>
    </div>
  </header>

  <section class="p-6 bg-white rounded-xl border border-slate-75">
    <div class="flex flex-col flex-grow gap-1">
      <h2 class="text-sm font-semibold text-slate-800"><%= t('super_admin.settings.edition') %></h2>
      <p class="m-0 text-sm text-slate-600"><%= t('super_admin.settings.plan_details_html') %></p>
    </div>
  </section>

  <div class="flex flex-col gap-4">
    <h2 class="text-base font-semibold text-slate-800"><%= t('super_admin.settings.features') %></h2>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      <% SuperAdmin::FeaturesHelper.available_features.each do |feature, attrs| %>
        <div class="flex relative flex-col gap-3 p-5 bg-white rounded-xl border border-slate-75">
          <span class="<%= attrs[:enabled] ? 'bg-green-100 text-green-700' : 'bg-slate-50 text-slate-600' %> absolute inline-flex right-4 top-5 p-1.5 rounded-full">
            <svg width="14" height="14"><use xlink:href="<%= attrs[:enabled] ? '#icon-tick-line': '#icon-lock-line' %>" /></svg>
          </span>

          <div class="flex justify-center items-center w-10 h-10 rounded-full border border-slate-75 text-slate-800">
            <svg width="20" height="20"><use xlink:href="#<%= attrs[:icon] %>" /></svg>
          </div>

          <div class="flex gap-2 items-center pr-10">
            <h3 class="text-sm font-semibold text-slate-800"><%= t("super_admin.features.#{feature}.name", default: attrs[:name]) %></h3>
            <% if attrs[:config_key].present? && attrs[:enabled] %>
              <a class="inline-flex justify-center items-center w-5 h-5 rounded shrink-0 text-slate-600 hover:text-woot-600" href="<%= attrs[:config_url] || "/super_admin/app_config?config=#{attrs[:config_key]}" %>">
                <svg width="18" height="18"><use xlink:href="#icon-gear" /></svg>
              </a>
            <% end %>
          </div>

          <p class="m-0 text-sm text-slate-600"><%= t("super_admin.features.#{feature}.description", default: attrs[:description]) %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
