<% account = page.resource %>
<% license = account.account_license %>
<% summary = Licensing::Summary.new(account).as_json %>
<section class="flex flex-col gap-4 p-6 bg-white rounded-xl border border-slate-75">
  <h2 class="text-base font-semibold text-slate-800">License</h2>

  <% if license.present? %>
    <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
      <dt class="font-medium text-slate-600">Plan / state</dt>
      <dd class="text-slate-800"><%= license.plan_key %> / <strong><%= summary[:state] %></strong><%= ' (trial)' if license.trial? %></dd>
      <dt class="font-medium text-slate-600">Expires</dt>
      <dd class="text-slate-800"><%= license.expires_at&.to_fs(:long) || 'never' %> <%= "(#{summary[:days_left]} days left)" if summary[:days_left] %></dd>
      <dt class="font-medium text-slate-600">Enforcement</dt>
      <dd class="text-slate-800"><%= license.enforce? ? 'ON (blocking)' : 'OFF (shadow mode: log only)' %></dd>
      <% summary[:usage].each do |metric, row| %>
        <% next if metric == 'inboxes_by_channel' %>
        <dt class="font-medium text-slate-600"><%= metric %></dt>
        <dd class="text-slate-800"><%= row[:used] %> / <%= row[:limit] || 'unlimited' %></dd>
      <% end %>
      <% summary[:usage]['inboxes_by_channel'].each do |channel, row| %>
        <dt class="font-medium text-slate-600">inbox: <%= channel %></dt>
        <dd class="text-slate-800"><%= row[:used] %> / <%= row[:limit] %></dd>
      <% end %>
    </dl>

    <%= form_with url: update_license_super_admin_account_path(account), method: :post, class: "flex flex-wrap gap-2 items-center" do %>
      <input type="number" name="days" value="14" min="1" class="w-20 rounded-lg border border-slate-75 px-2 py-1 text-sm">
      <button name="license_action" value="extend" class="px-3 py-2 text-sm rounded-lg border border-slate-75 hover:text-woot-600">Extend days</button>
      <button name="license_action" value="<%= license.suspended? ? 'resume' : 'suspend' %>" class="px-3 py-2 text-sm rounded-lg border border-slate-75 hover:text-woot-600"><%= license.suspended? ? 'Resume' : 'Suspend' %></button>
      <button name="license_action" value="<%= license.enforce? ? 'enforce_off' : 'enforce_on' %>" class="px-3 py-2 text-sm rounded-lg border border-slate-75 hover:text-woot-600"><%= license.enforce? ? 'Switch to shadow mode' : 'Turn enforcement on' %></button>
    <% end %>
  <% else %>
    <p class="text-sm text-slate-600">No license: this account is unrestricted.</p>
  <% end %>

  <%= form_with url: assign_license_super_admin_account_path(account), method: :post, class: "flex flex-wrap gap-2 items-center" do %>
    <select name="plan_key" class="rounded-lg border border-slate-75 px-2 py-1 text-sm">
      <% Licensing::PlanAssigner.plans.each_key do |key| %><option value="<%= key %>"><%= key %></option><% end %>
    </select>
    <input type="number" name="duration_days" placeholder="days (preset)" min="1" class="w-32 rounded-lg border border-slate-75 px-2 py-1 text-sm">
    <label class="text-sm text-slate-800"><input type="checkbox" name="enforce" value="true"> enforce now</label>
    <button class="px-3 py-2 text-sm font-medium rounded-lg text-white bg-woot-500 hover:bg-woot-600">Assign plan (resets features and quotas)</button>
  <% end %>

  <%= form_with url: save_license_super_admin_account_path(account), scope: :license, method: :post, class: "flex flex-col gap-4 pt-4 border-t border-slate-75" do |f| %>
    <h3 class="text-sm font-semibold text-slate-800">Custom limits <span class="font-normal text-slate-600">(leave a box empty = unlimited)</span></h3>
    <% q = license&.quotas || {} %>
    <div class="grid gap-3 sm:grid-cols-3">
      <label class="text-sm text-slate-800">Expires on
        <input type="date" name="license[expires_on]" value="<%= license&.expires_at&.to_date %>" class="block w-full rounded-lg border border-slate-75 px-2 py-1">
      </label>
      <label class="text-sm text-slate-800">Grace days
        <input type="number" min="0" name="license[grace_days]" value="<%= license&.grace_days || 3 %>" class="block w-full rounded-lg border border-slate-75 px-2 py-1">
      </label>
      <label class="text-sm text-slate-800">When quota is exceeded
        <select name="license[overage_policy]" class="block w-full rounded-lg border border-slate-75 px-2 py-1">
          <% { 'block' => 'Block', 'allow' => 'Allow (just record usage)' }.each do |value, label| %>
            <option value="<%= value %>" <%= 'selected' if (license&.overage_policy || 'block') == value %>><%= label %></option>
          <% end %>
        </select>
      </label>
    </div>
    <div class="grid gap-3 sm:grid-cols-5">
      <% { 'agents' => 'Agents', 'inboxes' => 'Inboxes', 'messages' => 'Messages (sent)', 'calls' => 'Calls', 'call_minutes' => 'Call minutes' }.each do |key, label| %>
        <label class="text-sm text-slate-800"><%= label %>
          <input type="number" min="0" name="license[<%= key %>]" value="<%= q[key] %>" placeholder="unlimited" class="block w-full rounded-lg border border-slate-75 px-2 py-1">
        </label>
      <% end %>
    </div>
    <div>
      <p class="mb-2 text-sm text-slate-800">Max inboxes per channel type <span class="text-slate-600">(0 = channel not allowed)</span></p>
      <div class="grid gap-3 sm:grid-cols-5">
        <% Licensing::CustomPlan::CHANNEL_KEYS.each do |key| %>
          <label class="text-xs text-slate-600"><%= key %>
            <input type="number" min="0" name="license[channels][<%= key %>]" value="<%= (q['inboxes_by_channel'] || {})[key] %>" placeholder="unlimited" class="block w-full rounded-lg border border-slate-75 px-2 py-1 text-sm">
          </label>
        <% end %>
      </div>
    </div>
    <label class="text-sm text-slate-800"><input type="checkbox" name="license[trial]" value="true" <%= 'checked' if license&.trial? %>> Trial (usage counted over the whole trial instead of per month)</label>
    <div><button class="px-3 py-2 text-sm font-medium rounded-lg text-white bg-woot-500 hover:bg-woot-600"><%= license ? 'Save limits' : 'Create custom license' %></button></div>
  <% end %>
</section>
