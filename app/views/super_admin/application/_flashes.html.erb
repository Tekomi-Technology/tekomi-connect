<%#
# Flash Partial

This partial renders flash messages on every page.

## Relevant Helpers:

- `flash`:
  Returns a hash,
  where the keys are the type of flash (alert, error, notice, etc)
  and the values are the message to be displayed.
%>

<% if flash.any? %>
  <div class="flex flex-col gap-2 px-8 pt-6">
    <% flash.each do |key, value| -%>
      <% tone = %w[alert error].include?(key.to_s) ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>
      <div class="px-4 py-3 text-sm rounded-lg <%= tone %>"><%= value.to_s.html_safe %></div>
    <% end -%>
  </div>
<% end %>
