<li class="px-3 mb-0.5">
  <details class="group/details" <%= 'open' if open %>>
    <summary class="group flex items-center gap-2.5 px-2.5 py-2 rounded-lg cursor-pointer list-none <%= open ? 'bg-woot-50 text-woot-600 font-medium' : 'text-slate-800 hover:bg-slate-25 hover:text-woot-600' %>">
      <%= link_to super_admin_settings_url, class: 'flex flex-1 gap-2.5 items-center min-w-0' do %>
        <span class="flex justify-center items-center w-5 h-5 shrink-0 <%= open ? 'text-woot-600' : 'text-slate-600 group-hover:text-woot-600' %>">
          <svg width="18" height="18"><use xlink:href="#icon-settings-2-line" /></svg>
        </span>
        <span class="text-sm truncate"><%= t('super_admin.settings.title') %></span>
      <% end %>
      <svg class="ml-auto w-4 h-4 transition-transform duration-200 shrink-0 group-open/details:rotate-180" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </summary>
    <ul class="pl-7 mt-1">
      <% settings_pages.each do |feature_key, attrs| %>
        <% url = attrs['config_url'] || super_admin_app_config_url(config: attrs['config_key']) %>
        <li class="mb-0.5">
          <%= link_to url, class: "flex items-center px-2.5 py-1.5 rounded-lg #{current_page?(url) ? 'bg-woot-50 text-woot-600 font-medium' : 'text-slate-800 hover:bg-slate-25 hover:text-woot-600'}" do %>
            <span class="text-sm truncate"><%= t("super_admin.features.#{feature_key}.name", default: attrs['name']) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
</li>
