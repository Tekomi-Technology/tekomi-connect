<form class="flex relative items-center w-full sm:w-64" role="search">
  <label class="flex absolute left-3 justify-center items-center pointer-events-none text-slate-600" for="search">
    <svg class="w-4 h-4" role="img">
      <title>
        <%= t("administrate.search.label", resource: resource_name) %>
      </title>
      <use xlink:href="#icon-eyeglass" />
    </svg>
  </label>

  <input class="py-2 pr-9 pl-9 w-full h-10 text-sm bg-white rounded-lg border border-slate-75 text-slate-800 placeholder:text-slate-600 focus:border-woot-500 focus:outline-none"
         id="search"
         type="search"
         name="search"
         placeholder="<%= t("administrate.search.label", resource: resource_name) %>"
         value="<%= search_term %>">

  <%= link_to clear_search_params, class: "flex absolute right-3 justify-center items-center text-slate-600 hover:text-woot-600" do %>
    <svg class="w-4 h-4" role="img">
      <title><%= t("administrate.search.clear") %></title>
      <use xlink:href="#icon-cancel" />
    </svg>
  <% end %>
</form>
