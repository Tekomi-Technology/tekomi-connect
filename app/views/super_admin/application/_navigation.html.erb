<%#
# Navigation

This partial is used to display the navigation in Administrate.
By default, the navigation contains navigation links
for all resources in the admin dashboard,
as defined by the routes in the `admin/` namespace
%>

<%= vite_client_tag %>
<%= vite_javascript_tag 'superadmin_pages' %>

<%
  sidebar_icons = {
    accounts: 'icon-building-4-line',
    users: 'icon-user-follow-line',
    platform_apps: 'icon-apps-2-line',
    agent_bots: 'icon-robot-line',
    platform_banners: 'icon-megaphone-line',
  }
%>

<div class="flex flex-col flex-shrink-0 justify-between h-full bg-white border-r w-60 border-slate-75" role="navigation">
  <div>
    <div class="flex flex-col gap-3 px-5 py-6 border-b border-slate-75">
      <%= link_to super_admin_root_url, class: 'block' do %>
        <%= image_tag '/brand-assets/logo.svg', alt: "#{application_title} #{t('super_admin.navigation.admin_dashboard')}", class: 'object-contain object-left w-auto max-w-full h-11' %>
      <% end %>
      <div class="flex flex-col gap-0.5">
        <div class="flex gap-2 items-baseline">
          <span class="text-base font-semibold truncate text-slate-800"><%= application_title %></span>
          <span class="px-1.5 py-0.5 text-xxs font-semibold rounded-md shrink-0 bg-woot-50 text-woot-600"><%= Chatwoot.config[:version] %></span>
        </div>
        <div class="text-xs text-slate-600"><%= t('super_admin.navigation.console') %></div>
      </div>
    </div>

    <ul class="py-4">
      <li class="px-5 pt-1 pb-2 text-xxs font-semibold tracking-widest uppercase text-slate-500">
        <%= t('super_admin.navigation.group_core') %>
      </li>
      <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_root_url, label: t('super_admin.navigation.dashboard') } %>
      <% Administrate::Namespace.new(namespace).resources.each do |resource| %>
        <% next if ["account_users", "access_tokens", "installation_configs", "dashboard", "devise/sessions", "app_configs", "instance_statuses", "role_matrices", "settings", "push_diagnostics", "llm_providers", "llm_feature_models", "llm_prompt_templates"].include?  resource.resource %>
        <% next if resource.resource == "platform_banners" && !ChatwootApp.chatwoot_cloud? %>
        <%= render partial: "nav_item", locals: {
            icon: sidebar_icons[resource.resource.to_sym],
            url: resource_index_route(resource),
            label: display_resource_name(resource),
          }
        %>

      <% end %>
      <%= render 'settings_menu', open: settings_open? %>
    </ul>
  </div>
  <div>
    <ul class="py-4 border-t border-slate-75">
      <li class="px-5 pt-1 pb-2 text-xxs font-semibold tracking-widest uppercase text-slate-500">
        <%= t('super_admin.navigation.group_operations') %>
      </li>
      <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_url, label: t('super_admin.navigation.sidekiq') } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_instance_status_url, label: t('super_admin.navigation.instance_health') } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-lock-line', url: super_admin_role_matrix_url, label: t('super_admin.navigation.role_matrix') } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-mail-send-fill', url: super_admin_push_diagnostics_url, label: t('super_admin.navigation.push_diagnostics') } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/', label: t('super_admin.navigation.agent_dashboard') } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_url, label: t('super_admin.navigation.logout') } %>
    </ul>
  </div>
</div>
