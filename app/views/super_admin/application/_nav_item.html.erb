<li class="px-3 mb-0.5">
  <% active = current_page?(url) %>
  <% color = local_assigns.fetch(:color, 'text-slate-600') %>
  <%= link_to(url, class: "group flex items-center gap-2.5 px-2.5 py-2 rounded-lg focus:outline-none cursor-pointer #{active ? 'bg-slate-25 text-slate-800 font-medium' : 'text-slate-800 hover:bg-slate-25'}") do %>
    <span class="flex justify-center items-center w-5 h-5 shrink-0 <%= color %>">
      <svg width="18" height="18"><use xlink:href="#<%= icon %>" /></svg>
    </span>
    <span class="text-sm truncate"><%= label %></span>
  <% end %>
</li>
