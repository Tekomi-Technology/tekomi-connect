<% content_for(:title) do %>
  <%= t('super_admin.role_matrix.title') %>
<% end %>
<%
  # Green for full access, yellow for a limited scope, grey for no access.
  limited_values = %w[view_only assigned_inboxes own_macros]
  value_class = lambda do |value|
    return 'bg-slate-50 text-slate-600' if value == 'deny'
    return 'bg-yellow-100 text-yellow-700' if limited_values.include?(value)

    'bg-green-100 text-green-700'
  end
  roles = @role_matrix['roles']
%>

<div class="flex flex-col gap-6 px-8 pt-8 pb-12 min-h-full bg-slate-25">
  <header class="flex flex-col gap-1" role="banner">
    <h1 class="text-2xl font-bold text-slate-800" id="page-title">
      <%= content_for(:title) %>
    </h1>
    <p class="max-w-prose text-sm text-slate-600"><%= t('super_admin.role_matrix.description') %></p>
  </header>

  <section class="overflow-x-auto bg-white rounded-xl border border-slate-75">
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b border-slate-75">
          <th class="px-5 py-3 text-xs font-semibold tracking-wide text-left uppercase text-slate-600"><%= t('super_admin.role_matrix.feature') %></th>
          <% roles.each do |role| %>
            <th class="px-5 py-3 text-xs font-semibold tracking-wide text-left uppercase whitespace-nowrap text-slate-600"><%= t("super_admin.role_matrix.roles.#{role}") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @role_matrix['groups'].each do |group, rows| %>
          <tr class="border-b border-slate-75">
            <td colspan="<%= roles.size + 1 %>" class="px-5 py-2.5 text-xs font-semibold tracking-wide uppercase bg-slate-25 text-slate-800">
              <%= t("super_admin.role_matrix.groups.#{group}.title") %>
            </td>
          </tr>
          <% rows.each do |row, values| %>
            <tr class="border-b border-slate-50 last:border-0">
              <td class="px-5 py-3 text-sm text-slate-800"><%= t("super_admin.role_matrix.groups.#{group}.rows.#{row}") %></td>
              <% roles.each do |role| %>
                <td class="px-5 py-3">
                  <span class="inline-block px-2 py-0.5 text-xs font-medium whitespace-nowrap rounded-full <%= value_class.call(values[role]) %>">
                    <%= t("super_admin.role_matrix.values.#{values[role]}") %>
                  </span>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </section>

  <p class="text-xs text-slate-600"><%= t('super_admin.role_matrix.source_note') %></p>
</div>
