<% content_for(:title) do %><%= t('super_admin.push_diagnostics.title') %><% end %>

<div class="flex flex-col gap-6 px-8 pt-8 pb-12 min-h-full bg-slate-25">
  <header class="flex flex-col gap-1" role="banner">
    <h1 class="text-2xl font-bold text-slate-800" id="page-title"><%= t('super_admin.push_diagnostics.title') %></h1>
    <p class="max-w-prose text-sm text-slate-600"><%= t('super_admin.push_diagnostics.description') %></p>
  </header>

  <div class="flex flex-col gap-4 p-6 bg-white rounded-xl border border-slate-75">
    <h2 class="text-base font-semibold text-slate-800"><%= t('super_admin.push_diagnostics.lookup.title') %></h2>
    <%= form_with url: super_admin_push_diagnostics_path, method: :get, local: true, class: 'flex gap-2 items-center' do |f| %>
      <%= f.text_field :user_query,
                       value: @query,
                       placeholder: t('super_admin.push_diagnostics.lookup.placeholder'),
                       class: 'sm:w-80 px-3 py-2 w-full text-sm rounded-lg border border-slate-75 text-slate-800 focus:border-woot-500 focus:outline-none' %>
      <%= f.submit t('super_admin.push_diagnostics.lookup.button'), class: 'px-3.5 py-2 text-sm font-medium rounded-lg border cursor-pointer border-slate-75 text-slate-800 hover:text-woot-600' %>
    <% end %>
    <% if @query.present? && @user.nil? %>
      <p class="text-sm text-red-700"><%= t('super_admin.push_diagnostics.lookup.not_found', query: @query) %></p>
    <% end %>
  </div>

  <% if @user %>
    <div class="flex flex-col gap-4 p-6 bg-white rounded-xl border border-slate-75">
      <p class="text-sm">
        <strong><%= @user.name %></strong>
        &middot; <%= @user.email %>
        &middot; ID <%= @user.id %>
      </p>
      <% if @user.accounts.any? %>
        <p class="text-xs text-slate-600">
          <%= t('super_admin.push_diagnostics.accounts') %>
          <% @user.accounts.each_with_index do |account, index| %>
            <%= ', ' if index.positive? %>
            <%= account.name %> (ID <%= account.id %>)
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="flex flex-col gap-4 p-6 bg-white rounded-xl border border-slate-75">
      <h2 class="text-base font-semibold text-slate-800"><%= t('super_admin.push_diagnostics.subscriptions.title', count: @subscriptions.count) %></h2>
      <p class="text-xs text-yellow-700">
        <%= t('super_admin.push_diagnostics.subscriptions.warning') %>
      </p>

      <% if @subscriptions.empty? %>
        <p class="text-sm text-slate-600"><%= t('super_admin.push_diagnostics.subscriptions.empty') %></p>
      <% else %>
        <%= form_with url: super_admin_push_diagnostics_path, method: :post, local: true do |f| %>
          <%= f.hidden_field :user_id, value: @user.id %>
          <div class="mb-4 max-w-2xl">
            <div class="mb-3">
              <%= label_tag :push_title, t('super_admin.push_diagnostics.form.title'), class: 'block text-xs font-medium text-slate-600 mb-1' %>
              <%= text_field_tag :push_title,
                                  params[:push_title].presence || Notification::PushTestService.default_title,
                                  class: 'px-3 py-2 w-full text-sm rounded-lg border border-slate-75 text-slate-800 focus:border-woot-500 focus:outline-none' %>
            </div>
            <div>
              <%= label_tag :push_body, t('super_admin.push_diagnostics.form.body'), class: 'block text-xs font-medium text-slate-600 mb-1' %>
              <%= text_area_tag :push_body,
                                 params[:push_body].presence || Notification::PushTestService.default_body,
                                 rows: 2,
                                 class: 'px-3 py-2 w-full text-sm rounded-lg border border-slate-75 text-slate-800 focus:border-woot-500 focus:outline-none' %>
            </div>
            <p class="text-xs text-slate-600"><%= t('super_admin.push_diagnostics.form.hint') %></p>
          </div>
          <table class="w-full text-sm border-collapse">
            <thead class="border-b border-slate-75">
              <tr>
                <th class="px-4 py-3 align-middle"><input type="checkbox" id="toggle-all"></th>
                <th class="px-4 py-3">ID</th>
                <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.type') %></th>
                <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.device_endpoint') %></th>
                <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.push_token') %></th>
                <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.device_details') %></th>
                <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.created') %></th>
                <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.last_updated') %></th>
              </tr>
            </thead>
            <tbody>
              <% @subscriptions.each do |sub| %>
                <% attrs = (sub.subscription_attributes || {}).stringify_keys %>
                <% if sub.browser_push? %>
                  <% endpoint = attrs['endpoint'].to_s %>
                  <% host = (begin; URI.parse(endpoint).host; rescue URI::InvalidURIError; nil; end) %>
                  <% device_display = host.presence || endpoint.presence || '—' %>
                  <% token_display = endpoint.present? ? "…#{endpoint.last(6)}" : '—' %>
                <% else %>
                  <% device_display = attrs['device_id'].present? ? "…#{attrs['device_id'].to_s.last(6)}" : '—' %>
                  <% token_display = attrs['push_token'].present? ? "…#{attrs['push_token'].to_s.last(6)}" : '—' %>
                <% end %>
                <% extra_attrs = attrs.except('endpoint', 'p256dh', 'auth', 'push_token', 'device_id') %>
                <tr class="border-b border-slate-50 last:border-0 align-middle">
                  <td class="px-4 py-3">
                    <%= check_box_tag 'subscription_ids[]', sub.id, false, class: 'subscription-checkbox' %>
                  </td>
                  <td class="px-4 py-3"><%= sub.id %></td>
                  <td class="px-4 py-3"><%= sub.subscription_type %></td>
                  <td class="px-4 py-3 font-mono text-xs break-all"><%= device_display %></td>
                  <td class="px-4 py-3 font-mono text-xs break-all"><%= token_display %></td>
                  <td class="px-4 py-3 text-xs align-top">
                    <% if extra_attrs.present? %>
                      <% extra_attrs.each do |k, v| %>
                        <div><span class="text-slate-600"><%= k %>:</span> <span class="font-mono"><%= v.to_s.truncate(40) %></span></div>
                      <% end %>
                    <% else %>
                      <span class="text-slate-600">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap"><%= sub.created_at.strftime('%Y-%m-%d %H:%M') %></td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <%= sub.updated_at.strftime('%Y-%m-%d %H:%M') %>
                    <span class="text-xs text-slate-600">(<%= t('super_admin.push_diagnostics.time_ago', time: time_ago_in_words(sub.updated_at)) %>)</span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <div class="mt-4 flex gap-2">
            <%= f.submit t('super_admin.push_diagnostics.actions.send'),
                         class: 'px-3.5 py-2 text-sm font-semibold text-white rounded-lg cursor-pointer bg-woot-500 hover:bg-woot-600' %>
            <%= submit_tag t('super_admin.push_diagnostics.actions.delete'),
                           formaction: destroy_subscriptions_super_admin_push_diagnostics_path,
                           formmethod: 'post',
                           data: { confirm: t('super_admin.push_diagnostics.actions.delete_confirm') },
                           class: 'px-3.5 py-2 text-sm font-medium rounded-lg border cursor-pointer border-red-200 text-red-700 hover:bg-red-100' %>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if @results.present? %>
      <div class="flex flex-col gap-4 p-6 bg-white rounded-xl border border-slate-75">
        <h2 class="text-base font-semibold text-slate-800"><%= t('super_admin.push_diagnostics.results.title') %></h2>
        <table class="w-full text-sm border-collapse">
          <thead class="border-b border-slate-75">
            <tr>
              <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.sub_id') %></th>
              <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.type') %></th>
              <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.device') %></th>
              <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.push_token') %></th>
              <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.status') %></th>
              <th class="px-4 py-3"><%= t('super_admin.push_diagnostics.columns.details') %></th>
            </tr>
          </thead>
          <tbody>
            <% @results.each do |r| %>
              <tr class="border-b border-slate-50 last:border-0 align-top">
                <td class="px-4 py-3"><%= r[:id] %></td>
                <td class="px-4 py-3"><%= r[:type] %></td>
                <td class="px-4 py-3 font-mono text-xs break-all"><%= r[:device] %></td>
                <td class="px-4 py-3 font-mono text-xs break-all"><%= r[:token_tail] %></td>
                <td class="px-4 py-3">
                  <%
                    color = {
                      success: 'bg-green-100 text-green-700',
                      failure: 'bg-red-100 text-red-700',
                      skipped: 'bg-slate-50 text-slate-600'
                    }[r[:status]]
                  %>
                  <span class="px-2 py-0.5 rounded-full text-xs <%= color %>"><%= t("super_admin.push_diagnostics.statuses.#{r[:status]}", default: r[:status].to_s) %></span>
                </td>
                <td class="px-4 py-3 font-mono text-xs break-all whitespace-pre-wrap"><%= r[:message] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</div>

<% content_for :javascript do %>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('toggle-all');
      if (!toggle) return;
      toggle.addEventListener('change', (event) => {
        document.querySelectorAll('.subscription-checkbox').forEach((cb) => {
          cb.checked = event.target.checked;
        });
      });
    });
  </script>
<% end %>
