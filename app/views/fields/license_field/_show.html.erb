<% tone = { 'trial' => 'bg-blue-50 text-blue-700', 'active' => 'bg-green-50 text-green-700', 'grace' => 'bg-yellow-50 text-yellow-700',
            'restricted' => 'bg-red-50 text-red-700', 'suspended' => 'bg-red-50 text-red-700' }[field.state] || 'text-slate-500' %>
<span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= tone %>"><%= field.to_s %></span>
